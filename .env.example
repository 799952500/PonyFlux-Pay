# PonyFlux-Pay 本地 / Docker 环境变量示例

DB_PASSWORD=root
MYSQL_ROOT_PASSWORD=root

# Admin JWT（生产务必更换）
PAYFLOW_JWT_SECRET=change-me-in-production

# 服务间内部令牌（admin ↔ recon）
PAYFLOW_INTERNAL_TOKEN=dev-internal-token

# channelConfig AES（与 admin/cashier 一致）
PAYFLOW_CRYPTO_KEY=0123456789abcdef0123456789abcdef
